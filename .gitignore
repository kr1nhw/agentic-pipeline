# local secrets / environment
.remote.env
.env
*.pem

# python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# run artifacts
out/
work/
cache/
*.parquet
*.png
!tests/fixtures/**/*.png

# local input corpus (PDF/pptx source docs) — not for version control
/dataset/

# os
.DS_Store

# local dev toolchain
.uv-cache/
.uv-python/

# generated by tools/build_image.sh from pyproject.toml
requirements.txt

# local run scratch — every root-level dot folder (.eval-run*/, .eval-work*/,
# .probe-work*/, .pw/, .sig-*/, .topo-*/, .work-all/, .run-*/, .sql-*/, ...),
# except the tooling config that must stay visible to git
/.*
!/.github/
!/.gitignore
!/.dockerignore
